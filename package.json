{
  "name": "mtls-universal-proxy",
  "version": "1.0.8",
  "description": "Zero-trust mTLS forward proxy server and client SDK for Node.js",
  "main": "./lib/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcerise/mtls-universal-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/mrcerise/mtls-universal-proxy/issues"
  },
  "homepage": "https://github.com/mrcerise/mtls-universal-proxy#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mtls",
    "proxy",
    "tls",
    "security",
    "zero-trust",
    "forward-proxy",
    "https-proxy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^25.0.9"
  }
}
